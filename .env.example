# Get these from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Your Telegram phone (international format, no spaces) — first login only
PHONE_NUMBER=+10000000000

# all = every group you joined | or list: group1,group2
GROUP_TARGETS=all

# Live mode: history + watch new messages
LIVE_MODE=true
LIVE_SCRAPE_HISTORY=true

# Auto-save usernames every N new users (default: 100)
AUTO_SAVE_INTERVAL=100

# Batch export size for Excel files in output/exports/ (default: 10000)
BATCH_SIZE=10000
